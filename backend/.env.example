# ──────────────────────────────
# SERVER
# ──────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ──────────────────────────────
# DATABASE
# ──────────────────────────────
MONGO_URI=your_mongodb_atlas_connection_string

# ──────────────────────────────
# JWT AUTHENTICATION
# ──────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRES_IN=15m

# Short-lived token issued after Forgot Password OTP verification,
# consumed by POST /auth/forgot-password/reset. Defaults to 10m if unset.
PASSWORD_RESET_TOKEN_EXPIRES_IN=10m

# ──────────────────────────────
# ADMIN
# ──────────────────────────────
# Required as the "adminSecret" field when calling POST /auth/admin/register
# — keeps random visitors from creating admin accounts. Leave blank locally
# if you don't need that check.
ADMIN_REGISTER_SECRET=change_this_to_a_long_random_value

# ──────────────────────────────
# CLOUDINARY
# ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ──────────────────────────────
# EMAIL / OTP (NODEMAILER)
# ──────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM=RungtaStudentXchange <no-reply@rungtastudentxchange.com>
OTP_EXPIRY_MINUTES=10

# ──────────────────────────────
# RATE LIMITING
# ──────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX_REQUESTS=5
